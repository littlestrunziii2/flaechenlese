<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_progress_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_progress_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FORTSCHRITT"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:alpha="0.5"
        android:letterSpacing="0.2" />

    <TextView
        android:id="@+id/widget_month_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_progress_title"
        android:layout_marginTop="4dp"
        android:text="Monat"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_below="@id/widget_month_name"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/widget_checked_bg_color"
        android:progressBackgroundTint="#3A3A3C" />

    <TextView
        android:id="@+id/widget_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_progress_bar"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="4dp"
        android:text="0/30"
        android:textSize="12sp"
        android:textColor="#8E8E93" />

</RelativeLayout>
